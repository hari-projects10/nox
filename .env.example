# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Gemini API key from aistudio.google.com → Get API key (free tier). Required.
GEMINI_API_KEY=

# Upstash Redis, shared by every serverless instance for the chat limits.
# Required on Vercel: without it the assistant stays offline (fails closed).
# Adding Upstash from the Vercel Marketplace sets KV_REST_API_* or
# STORAGE_REST_API_* (by its prefix) automatically; any of these works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: site-wide model calls per day (default 500). Keep it under the
# free tier's daily quota so real visitors get the replies.
# CHAT_DAILY_LIMIT=500

# Optional: site-wide messages per minute across all visitors (default 15).
# CHAT_GLOBAL_PER_MINUTE=15

# Optional: extra origins allowed to call /api/chat, comma separated.
# The site's own domain is always allowed.
# CHAT_ALLOWED_ORIGINS=https://www.example.com
